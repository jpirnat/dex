<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>
            {% if title %}
                Porydex - {{ title|e }}
            {% else %}
                Porydex
            {% endif %}
        </title>

        <link href="/css/normalize.css" rel="stylesheet">
        <link href="/css/main.css" rel="stylesheet">
        {% block styles %}
        {% endblock %}
    </head>
    <body>
        <header>
            {% block nav %}
                <nav class="nav-menu">
                    <div class="nav-menu__item">
                        <a class="nav-menu__link" href="/dex/champions/pokemon">Pokémon</a>
                        <div class="nav-menu__dropdown">
                            <a class="nav-menu__link" href="/dex/champions/advanced-pokemon-search">Advanced Search</a>
                        </div>
                    </div>
                    <div class="nav-menu__item">
                        <a class="nav-menu__link" href="/dex/champions/moves">Moves</a>
                        <div class="nav-menu__dropdown">
                            <a class="nav-menu__link" href="/dex/champions/advanced-move-search">Advanced Search</a>
                        </div>
                    </div>
                    <div class="nav-menu__item">
                        <a class="nav-menu__link" href="/dex/champions/types">Types</a>
                    </div>
                    <div class="nav-menu__item">
                        <a class="nav-menu__link" href="/dex/champions/items">Items</a>
                    </div>
                    <div class="nav-menu__item">
                        <a class="nav-menu__link" href="/dex/champions/abilities">Abilities</a>
                    </div>
                    <div class="nav-menu__item">
                        <a class="nav-menu__link" href="/dex/champions/natures">Natures</a>
                    </div>
                    <div class="nav-menu__item">
                        <a class="nav-menu__link" href="/battle-data">Battle Data</a>
                        <div class="nav-menu__dropdown">
                            <a class="nav-menu__link" href="/battle-data/current">Current Battle Data</a>
                        </div>
                    </div>
                    <div class="nav-menu__space"></div>
                    <div class="nav-menu__item">
                        <a class="nav-menu__link" href="/about">About</a>
                    </div>
                </nav>

                {% if breadcrumbs %}
                    <nav class="breadcrumbs" aria-label="Breadcrumb">
                        <a class="breadcrumbs__item" href="/">Home</a>
                        {% for breadcrumb in breadcrumbs %}
                            <span class="breadcrumbs__separator">»</span>
                            {% if breadcrumb.url %}
                                <a class="breadcrumbs__item" href="{{ breadcrumb.url|e }}">{{ breadcrumb.text|e }}</a>
                            {% else %}
                                <span class="breadcrumbs__item" {% if loop.last %}aria-current="page"{% endif %}>{{ breadcrumb.text|e }}</span>
                            {% endif %}
                        {% endfor %}
                    </nav>
                {% endif %}
            {% endblock %}
        </header>
        <main>
            {% block body %}
            {% endblock %}
        </main>
        <footer>
            <form class="change-language">
                <select name="language">
                    {% for language in languages %}
                        <option
                            value="{{ language.id|e }}"
                            {% if language.id == currentLanguageId %}
                                selected
                            {% endif %}
                        >
                            {{ language.name }}
                        </option>
                    {% endfor %}
                </select>

                <input type="submit" value="Change Language">
            </form>
        </footer>
        {% block scripts %}
        {% endblock %}
    </body>
</html>
